<?xml version="1.0" encoding="UTF-8"?>
<!-- Studio colour pipeline delegated to an OpenColorIO config: OCIO's built-in ACES CG config,
     ACEScg working space, the ACES 2.0 SDR view on an sRGB display. -->
<scene version="1.1">
  <project width="640" height="360" fps="24" duration="1" background="#000000"/>
  <colorManagement ocioConfig="ocio://cg-config-latest" workingSpace="acescg" display="sRGB - Display" view="ACES 2.0 - SDR 100 nits (Rec.709)"/>
  <composition>
    <shape id="card" shape="rect" x="0" y="0" width="640" height="360" fill="#808080"/>
  </composition>
</scene>
