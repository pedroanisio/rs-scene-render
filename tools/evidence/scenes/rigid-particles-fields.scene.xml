<?xml version="1.0" encoding="UTF-8"?>
<!-- Motion-graphics physics: falling rigid bodies, fire and sparks, and a vortex field. -->
<scene version="1.1">
  <project width="640" height="360" fps="24" duration="3" background="#101418"/>
  <composition>
    <shape id="b0" shape="rect" x="100" y="20" width="30" height="30" fill="#E06090"><rigidBody restitution="0.3"/></shape>
    <shape id="b1" shape="ellipse" x="300" y="10" width="28" height="28" fill="#E0C050"><rigidBody shape="circle" restitution="0.5"/></shape>
    <shape id="b2" shape="rect" x="500" y="30" width="30" height="30" fill="#60A0E0"><rigidBody restitution="0.3"/></shape>
    <particleEmitter id="fire" preset="fire" x="160" y="350" emitterShape="line" emitterWidth="120" rate="600" seed="1"/>
    <particleEmitter id="sparks" preset="sparks" x="480" y="300" rate="600" collide="true" seed="2"/>
  </composition>
  <physics bounds="frame" pixelsPerMeter="100">
    <!-- Keep the falling-body probe under gravity; the strong vortex drives the particles. -->
    <forceField id="swirl" type="vortex" affects="particles" x="320" y="180" strength="60" radius="300" falloff="1"/>
  </physics>
</scene>
