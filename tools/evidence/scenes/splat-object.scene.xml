<?xml version="1.0" encoding="UTF-8"?>
<!-- Captured-object look: a 3D Gaussian splat asset (.splat) turning in front of the camera. -->
<scene version="1.1">
  <project width="640" height="360" fps="24" duration="2" background="#000000"/>
  <assets>
    <mesh id="blob" src="ring.splat" format="splat"/>
  </assets>
  <composition>
    <object3D id="ring" primitive="mesh" mesh="blob" x="320" y="180" z="0">
      <animate property="rotationY"><key time="0" value="0"/><key time="2" value="180"/></animate>
    </object3D>
  </composition>
</scene>
