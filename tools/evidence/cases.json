{
  "version": 1,
  "about": "Reference-clip evidence: each case is a probe of one technique a reference clip depends on. The outcome is measured, never declared: tools/evidence.py renders the scene in --strict mode, runs the pixel checks and classifies the case. 'expect' records the last accepted outcome so a change in either direction fails the run.",
  "cases": [
    {
      "id": "stopmotion-holds",
      "reference": "Object stop-motion (PES-style replacement animation)",
      "technique": "imageSequence at 12 fps on a 24 fps timeline, missingFrame=hold",
      "scene": "scenes/stopmotion-holds.scene.xml",
      "expect": "native",
      "checks": [
        {
          "type": "color",
          "t": 0.0,
          "x": 320,
          "y": 180,
          "rgb": "#280000",
          "tol": 0.02,
          "why": "frame 1 at t=0"
        },
        {
          "type": "color",
          "t": 0.0417,
          "x": 320,
          "y": 180,
          "rgb": "#280000",
          "tol": 0.02,
          "why": "12 fps on twos: frame 1 holds for two 24 fps frames"
        },
        {
          "type": "color",
          "t": 0.0875,
          "x": 320,
          "y": 180,
          "rgb": "#500000",
          "tol": 0.02,
          "why": "frame 2 from t=1/12"
        },
        {
          "type": "color",
          "t": 0.2542,
          "x": 320,
          "y": 180,
          "rgb": "#A00000",
          "tol": 0.02,
          "why": "frame 4 from t=3/12"
        },
        {
          "type": "color",
          "t": 0.6667,
          "x": 320,
          "y": 180,
          "rgb": "#C80000",
          "tol": 0.02,
          "why": "frames 6-9 are missing: frame 5, the last on disk, holds"
        }
      ]
    },
    {
