          "not_rgb": "#000000",
          "tol": 0.03,
          "min": 0.01,
          "why": "the splats cover part of the frame"
        },
        {
          "type": "changes",
          "t": [
            0.0,
            1.0
          ],
          "region": [
            0,
            0,
            640,
            360
          ],
          "min": 0.002,
          "why": "the object turns"
        }
      ]
    },
