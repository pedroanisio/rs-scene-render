  <xs:complexType name="shakeType">
    <xs:attribute name="amplitude" type="nonNegativeDecimal" default="10"/>
    <xs:attribute name="frequency" type="positiveDecimal" default="2"/>
    <xs:attribute name="rotation" type="nonNegativeDecimal" default="0"/>
    <xs:attribute name="zoom" type="nonNegativeDecimal" default="0"/>
    <xs:attribute name="octaves" type="xs:positiveInteger" default="2"/>
    <xs:attribute name="seed" type="xs:unsignedLong"/>
    <xs:attribute name="start" type="xs:double" default="0"/>
    <xs:attribute name="end" type="xs:double"/>
  </xs:complexType>
  <xs:complexType name="cameraType">
    <xs:annotation><xs:documentation>
      Physical camera: when focalLength is set, fov derives from focalLength and
      sensorWidth (mm). depthOfField uses fStop, focusDistance (scene units) and
      apertureBlades. Several cameras may exist; the active one at time t is the
      last active camera whose [start, end) contains t (camera switching).
    </xs:documentation></xs:annotation>
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:group ref="animationElements"/>
      <xs:element name="shake" type="shakeType"/>
      <xs:element name="transformConstraint" type="transformConstraintType"/>
    </xs:choice>
    <xs:attribute name="id" type="xs:ID" use="required"/>
    <xs:attribute name="name" type="xs:string"/>
    <xs:attribute name="active" type="xs:boolean" default="true"/>
    <xs:attribute name="start" type="xs:double" default="0"/>
    <xs:attribute name="end" type="xs:double"/>
    <xs:attribute name="x" type="xs:double" default="0"/>
    <xs:attribute name="y" type="xs:double" default="0"/>
    <xs:attribute name="z" type="xs:double" default="0"/>
    <xs:attribute name="projection" default="perspective">
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="perspective"/><xs:enumeration value="orthographic"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="fov" type="positiveDecimal" default="60"/>
    <xs:attribute name="near" type="positiveDecimal" default="0.1"/>
    <xs:attribute name="far" type="positiveDecimal" default="10000"/>
    <xs:attribute name="yaw" type="xs:double" default="0"/>
    <xs:attribute name="pitch" type="xs:double" default="0"/>
    <xs:attribute name="roll" type="xs:double" default="0"/>
    <xs:attribute name="target" type="xs:IDREF"/>
    <xs:attribute name="focalLength" type="positiveDecimal"/>
    <xs:attribute name="sensorWidth" type="positiveDecimal" default="36"/>
    <xs:attribute name="sensorHeight" type="positiveDecimal" default="24"/>
    <xs:attribute name="orthoHeight" type="positiveDecimal"/>
    <xs:attribute name="depthOfField" type="xs:boolean" default="false"/>
    <xs:attribute name="fStop" type="positiveDecimal" default="2.8"/>
    <xs:attribute name="focusDistance" type="positiveDecimal" default="1000"/>
    <xs:attribute name="focusTarget" type="xs:IDREF"/>
    <xs:attribute name="apertureBlades" default="0">
      <xs:simpleType><xs:restriction base="xs:nonNegativeInteger"><xs:maxInclusive value="16"/></xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="shutterAngle" type="nonNegativeDecimal"/>
    <xs:attribute name="exposure" type="xs:double" default="0"/>
    <xs:attribute name="lensDistortion" type="xs:double" default="0"/>
  </xs:complexType>

  <xs:complexType name="groupType">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:group ref="nodeBehaviour"/>
      <xs:group ref="nodeChoice"/>
    </xs:choice>
    <xs:attributeGroup ref="nodeAttributes"/>
    <xs:attribute name="blend" type="blendType" default="normal"/>
    <xs:attribute name="effects" type="xs:IDREFS">
      <xs:annotation><xs:documentation>
        Effect ids applied in order to this group's isolated buffer (a group
        with effects is always isolated) instead of the final frame.
      </xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="isolate" type="xs:boolean" default="false"/>
    <xs:attribute name="collapse" type="xs:boolean" default="false">
      <xs:annotation><xs:documentation>Collapse transformations: 2.5D children share the parent's camera space instead of being flattened.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="width" type="positiveLengthType"/>
    <xs:attribute name="height" type="positiveLengthType"/>
    <xs:attribute name="clip" type="xs:boolean" default="false"/>
    <xs:attribute name="layout" default="none">
      <xs:annotation><xs:documentation>Automatic layout of children (flexbox subset): row, column, stack or grid with gap/padding/justify/alignItems.</xs:documentation></xs:annotation>
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="none"/><xs:enumeration value="row"/><xs:enumeration value="column"/>
        <xs:enumeration value="stack"/><xs:enumeration value="grid"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="gap" type="lengthType" default="0"/>
    <xs:attribute name="padding" type="lengthType" default="0"/>
    <xs:attribute name="justify" default="start">
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="start"/><xs:enumeration value="center"/><xs:enumeration value="end"/>
        <xs:enumeration value="space-between"/><xs:enumeration value="space-around"/><xs:enumeration value="space-evenly"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="alignItems" default="start">
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="start"/><xs:enumeration value="center"/><xs:enumeration value="end"/>
        <xs:enumeration value="stretch"/><xs:enumeration value="baseline"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="gridColumns" type="xs:positiveInteger" default="2"/>
    <xs:attribute name="timeOffset" type="xs:double" default="0"/>
    <xs:attribute name="timeScale" type="positiveDecimal" default="1"/>
  </xs:complexType>

  <xs:complexType name="sequenceType">
    <xs:annotation><xs:documentation>
      Children play one after another: each child's start is the previous
      child's end plus @timeGap seconds (negative values overlap). A child's own start is an
      additional offset. If @transition is set, every junction gets that
      transition with @transitionDuration unless an explicit transition exists.
    </xs:documentation></xs:annotation>
    <xs:complexContent><xs:extension base="groupType">
      <xs:attribute name="timeGap" type="xs:double" default="0"/>
      <xs:attribute name="transition" type="xs:NMTOKEN"/>
      <xs:attribute name="transitionDuration" type="positiveDecimal" default="0.5"/>
    </xs:extension></xs:complexContent>
  </xs:complexType>

  <!-- ===================================================== reuse and templating nodes -->
  <xs:complexType name="instanceType">
    <xs:annotation><xs:documentation>
      Instantiates a symbol (precomposition / component). The symbol runs on its
      own clock: local time = (t - start) * speed + clipIn, looped/reversed as
      for layers, or mapped by timeRemap. override children change attributes
      of elements inside this instance only; ids inside a symbol are scoped to
      the instance (effective id = instanceId/innerId).
    </xs:documentation></xs:annotation>
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:group ref="nodeBehaviour"/>
      <xs:element name="override" type="overrideType"/>
      <xs:element name="timeRemap" type="timeRemapType"/>
    </xs:choice>
    <xs:attributeGroup ref="nodeAttributes"/>
    <xs:attribute name="symbol" type="xs:IDREF" use="required"/>
    <xs:attribute name="blend" type="blendType" default="normal"/>
    <xs:attribute name="effects" type="xs:IDREFS"/>
    <xs:attribute name="clipIn" type="xs:double" default="0"/>
    <xs:attribute name="clipOut" type="xs:double"/>
    <xs:attribute name="loop" type="xs:nonNegativeInteger" default="0"/>
    <xs:attribute name="reverse" type="xs:boolean" default="false"/>
    <xs:attribute name="speed" type="xs:double" default="1"/>
    <xs:attribute name="fit" type="fitType" default="none"/>
    <xs:attribute name="boxWidth" type="positiveLengthType"/>
    <xs:attribute name="boxHeight" type="positiveLengthType"/>
  </xs:complexType>
  <xs:complexType name="includeType">
    <xs:annotation><xs:documentation>
      Pulls a symbol from another scene-render document (@src#@symbol) or that
      document's whole composition when @symbol is absent. The included file's
      assets, paints, styles and effects are merged under the namespace @id/.
    </xs:documentation></xs:annotation>
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:group ref="nodeBehaviour"/>
      <xs:element name="override" type="overrideType"/>
    </xs:choice>
    <xs:attributeGroup ref="nodeAttributes"/>
    <xs:attribute name="src" type="xs:anyURI" use="required"/>
    <xs:attribute name="symbol" type="xs:NCName"/>
    <xs:attribute name="sha256" type="sha256Type"/>
  </xs:complexType>
  <xs:complexType name="repeatType">
    <xs:annotation><xs:documentation>
      Generates copies of its children: @count copies, or one per item of the
      list parameter / data rows named by @over. Inside, expressions read
      index, count and param(@var) (the current item). Copy i receives the
      cumulative offsets i*offsetX, i*offsetY, i*rotationStep, scaleStep^i,
      opacity - i*opacityStep and a start delay of i*timeStep (stagger).
    </xs:documentation></xs:annotation>
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:group ref="nodeBehaviour"/>
      <xs:group ref="nodeChoice"/>
    </xs:choice>
    <xs:attributeGroup ref="nodeAttributes"/>
    <xs:attribute name="count" type="xs:nonNegativeInteger"/>
    <xs:attribute name="over" type="xs:IDREF"/>
    <xs:attribute name="var" type="xs:NCName" default="item"/>
    <xs:attribute name="from" type="xs:nonNegativeInteger" default="0"/>
    <xs:attribute name="step" type="xs:positiveInteger" default="1"/>
    <xs:attribute name="offsetX" type="xs:double" default="0"/>
    <xs:attribute name="offsetY" type="xs:double" default="0"/>
    <xs:attribute name="rotationStep" type="xs:double" default="0"/>
    <xs:attribute name="scaleStep" type="positiveDecimal" default="1"/>
    <xs:attribute name="opacityStep" type="unitDecimal" default="0"/>
    <xs:attribute name="timeStep" type="xs:double" default="0"/>
    <xs:attribute name="blend" type="blendType" default="normal"/>
  </xs:complexType>
  <xs:complexType name="adjustmentType">
    <xs:annotation><xs:documentation>
      Adjustment layer: applies @effects to the composite of every sibling below
      it (lower z / earlier in document order), limited by its masks, matte and
      opacity, during [start, end).
    </xs:documentation></xs:annotation>
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:group ref="nodeBehaviour"/>
    </xs:choice>
    <xs:attributeGroup ref="nodeAttributes"/>
    <xs:attribute name="effects" type="xs:IDREFS" use="required"/>
    <xs:attribute name="blend" type="blendType" default="normal"/>
  </xs:complexType>
  <xs:complexType name="transitionType">
    <xs:annotation><xs:documentation>
      Transition between sibling nodes @from (outgoing) and @to (incoming), or
      an in/out transition of a single node when only one is given. The
      transition window has length @duration, centred on the cut (alignment
      center), ending at it (end) or starting at it (start). The renderer
      extends the handles of both nodes by the needed amount.
    </xs:documentation></xs:annotation>
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:group ref="animationElements"/>
      <xs:element name="param" type="paramValueType"/>
    </xs:choice>
    <xs:attribute name="id" type="xs:ID"/>
    <xs:attribute name="type" use="required">
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="cut"/><xs:enumeration value="crossfade"/>
        <xs:enumeration value="additive-dissolve"/><xs:enumeration value="dip-to-color"/>
        <xs:enumeration value="wipe"/><xs:enumeration value="slide"/>
        <xs:enumeration value="push"/><xs:enumeration value="cover"/>
        <xs:enumeration value="reveal"/><xs:enumeration value="zoom-in"/>
        <xs:enumeration value="zoom-out"/><xs:enumeration value="spin"/>
        <xs:enumeration value="whip-pan"/><xs:enumeration value="circle-open"/>
        <xs:enumeration value="circle-close"/><xs:enumeration value="iris"/>
        <xs:enumeration value="clock-wipe"/><xs:enumeration value="radial-wipe"/>
        <xs:enumeration value="barn-door"/><xs:enumeration value="blinds"/>
        <xs:enumeration value="luma"/><xs:enumeration value="blur"/>
        <xs:enumeration value="glitch"/><xs:enumeration value="pixelize"/>
        <xs:enumeration value="flip"/><xs:enumeration value="cube"/>
        <xs:enumeration value="page-curl"/><xs:enumeration value="film-roll"/>
        <xs:enumeration value="stripe"/><xs:enumeration value="squash"/>
        <xs:enumeration value="shuffle"/><xs:enumeration value="carousel"/>
        <xs:enumeration value="light-leak"/><xs:enumeration value="morph"/>
        <xs:enumeration value="shader"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="from" type="xs:IDREF"/>
    <xs:attribute name="to" type="xs:IDREF"/>
    <xs:attribute name="duration" type="positiveDecimal" default="0.5"/>
    <xs:attribute name="alignment" default="center">
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="center"/><xs:enumeration value="start"/><xs:enumeration value="end"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="curve" type="curveType" default="ease-in-out"/>
    <xs:attribute name="direction" default="left">
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="left"/><xs:enumeration value="right"/><xs:enumeration value="up"/>
        <xs:enumeration value="down"/><xs:enumeration value="angle"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="angle" type="xs:double" default="0"/>
    <xs:attribute name="color" type="colorType" default="#000000FF"/>
    <xs:attribute name="softness" type="unitDecimal" default="0.1"/>
    <xs:attribute name="matte" type="xs:IDREF"/>
    <xs:attribute name="shader" type="xs:anyURI">
      <xs:annotation><xs:documentation>type="shader": GLSL fragment in the gl-transitions convention (vec4 transition(vec2 uv), uniform float progress).</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="motionBlur" type="xs:boolean" default="true"/>
    <xs:attribute name="audio" default="crossfade">
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="crossfade"/><xs:enumeration value="equal-power"/>
        <xs:enumeration value="cut"/><xs:enumeration value="none"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
  </xs:complexType>

  <xs:group name="nodeChoice">
    <xs:choice>
      <xs:element name="group" type="groupType"/>
      <xs:element name="sequence" type="sequenceType"/>
      <xs:element name="layer" type="layerType"/>
      <xs:element name="shape" type="shapeType"/>
      <xs:element name="object3D" type="object3DType"/>
      <xs:element name="camera" type="cameraType"/>
      <xs:element name="particleEmitter" type="particleEmitterType"/>
      <xs:element name="instance" type="instanceType"/>
      <xs:element name="include" type="includeType"/>
      <xs:element name="repeat" type="repeatType"/>
      <xs:element name="adjustment" type="adjustmentType"/>
      <xs:element name="transition" type="transitionType"/>
      <xs:element name="skeleton" type="skeletonType"/>
    </xs:choice>
  </xs:group>
  <xs:complexType name="compositionType">
    <xs:group ref="nodeChoice" minOccurs="0" maxOccurs="unbounded"/>
  </xs:complexType>
  <xs:complexType name="symbolType">
    <xs:group ref="nodeChoice" minOccurs="0" maxOccurs="unbounded"/>
    <xs:attribute name="id" type="xs:ID" use="required"/>
    <xs:attribute name="name" type="xs:string"/>
    <xs:attribute name="width" type="xs:positiveInteger"/>
    <xs:attribute name="height" type="xs:positiveInteger"/>
    <xs:attribute name="duration" type="durationType"/>
    <xs:attribute name="background" type="paintType" default="#00000000"/>
  </xs:complexType>
  <xs:complexType name="symbolsType">
    <xs:sequence><xs:element name="symbol" type="symbolType" maxOccurs="unbounded"/></xs:sequence>
  </xs:complexType>

  <!-- ===================================================== effects -->
  <xs:complexType name="effectType">
    <xs:annotation><xs:documentation>
      One element type for every effect; each type reads only the attributes it
      documents. Colour-grade family: color-grade (saturation/contrast/
      brightness, as 1.0), lift-gamma-gain (lift/gamma/gain "r,g,b"), cdl
      (slope/offset/power "r,g,b", saturation; ASC CDL), lut (@src .cube/.clf/
      .3dl, @space), curves (@curve "x,y x,y ..." per @channel), levels,
      white-balance (temperature/tint), exposure, hue-saturation, tonemap.
      shader: GLSL fragment at @src with param children as uniforms.
    </xs:documentation></xs:annotation>
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:group ref="animationElements"/>
      <xs:element name="param" type="paramValueType"/>
    </xs:choice>
    <xs:attribute name="id" type="xs:ID" use="required"/>
    <xs:attribute name="type" use="required">
      <xs:simpleType><xs:restriction base="xs:string">
        <!-- 1.0 -->
        <xs:enumeration value="glow"/><xs:enumeration value="bloom"/>
        <xs:enumeration value="blur"/><xs:enumeration value="color-grade"/>
        <xs:enumeration value="vignette"/><xs:enumeration value="lens-flare"/>
        <xs:enumeration value="drop-shadow"/><xs:enumeration value="lighting"/>
        <!-- blur family -->
        <xs:enumeration value="directional-blur"/><xs:enumeration value="radial-blur"/>
        <xs:enumeration value="zoom-blur"/><xs:enumeration value="lens-blur"/>
        <xs:enumeration value="pixel-motion-blur"/><xs:enumeration value="tilt-shift"/>
        <!-- colour -->
        <xs:enumeration value="lift-gamma-gain"/><xs:enumeration value="cdl"/>
        <xs:enumeration value="lut"/><xs:enumeration value="curves"/>
        <xs:enumeration value="levels"/><xs:enumeration value="white-balance"/>
        <xs:enumeration value="exposure"/><xs:enumeration value="hue-saturation"/>
        <xs:enumeration value="tonemap"/><xs:enumeration value="tint"/>
        <xs:enumeration value="tritone"/><xs:enumeration value="gradient-map"/>
        <xs:enumeration value="grayscale"/><xs:enumeration value="sepia"/>
        <xs:enumeration value="invert"/><xs:enumeration value="posterize"/>
        <xs:enumeration value="threshold"/><xs:enumeration value="color-overlay"/>
        <xs:enumeration value="gradient-overlay"/><xs:enumeration value="selective-color"/>
        <!-- stylise and texture -->
        <xs:enumeration value="film-grain"/><xs:enumeration value="noise"/>
        <xs:enumeration value="chromatic-aberration"/><xs:enumeration value="sharpen"/>
        <xs:enumeration value="unsharp-mask"/><xs:enumeration value="halation"/>
        <xs:enumeration value="light-leak"/><xs:enumeration value="light-sweep"/>
        <xs:enumeration value="glitch"/><xs:enumeration value="rgb-split"/>
        <xs:enumeration value="scanlines"/><xs:enumeration value="vhs"/>
        <xs:enumeration value="halftone"/><xs:enumeration value="pixelate"/>
        <xs:enumeration value="mosaic"/><xs:enumeration value="emboss"/>
        <xs:enumeration value="bevel"/><xs:enumeration value="inner-shadow"/>
        <xs:enumeration value="inner-glow"/><xs:enumeration value="long-shadow"/>
        <xs:enumeration value="stroke"/><xs:enumeration value="outline"/>
        <xs:enumeration value="echo"/><xs:enumeration value="posterize-time"/>
        <xs:enumeration value="letterbox"/><xs:enumeration value="mirror"/>
        <xs:enumeration value="kaleidoscope"/><xs:enumeration value="tile"/>
        <!-- distort -->
        <xs:enumeration value="displacement-map"/><xs:enumeration value="turbulent-displace"/>
        <xs:enumeration value="wave-warp"/><xs:enumeration value="ripple"/>
        <xs:enumeration value="twirl"/><xs:enumeration value="spherize"/>
        <xs:enumeration value="bulge"/><xs:enumeration value="lens-distortion"/>
        <xs:enumeration value="heat-haze"/>
        <!-- keying and matting -->
        <xs:enumeration value="chroma-key"/><xs:enumeration value="luma-key"/>
        <xs:enumeration value="difference-key"/><xs:enumeration value="spill-suppress"/>
        <xs:enumeration value="matte-choke"/>
        <!-- generative and custom -->
        <xs:enumeration value="fill"/><xs:enumeration value="fractal-noise"/>
        <xs:enumeration value="god-rays"/><xs:enumeration value="shader"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="enabled" type="xs:boolean" default="true"/>
    <xs:attribute name="mix" type="unitDecimal" default="1"/>
    <xs:attribute name="intensity" type="xs:double" default="1"/>
    <xs:attribute name="radius" type="effectRadiusType" default="4"/>
    <xs:attribute name="threshold" type="xs:double" default="0.7"/>
    <xs:attribute name="saturation" type="xs:double" default="1"/>
    <xs:attribute name="contrast" type="xs:double" default="1"/>
    <xs:attribute name="brightness" type="xs:double" default="0"/>
    <xs:attribute name="color" type="colorType"/>
    <xs:attribute name="paint" type="paintType"/>
    <xs:attribute name="offsetX" type="effectOffsetType" default="8"/>
    <xs:attribute name="offsetY" type="effectOffsetType" default="8"/>
    <xs:attribute name="lights" type="xs:IDREFS"/>
    <xs:attribute name="falloff" default="smooth">
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="linear"/><xs:enumeration value="quadratic"/>
        <xs:enumeration value="smooth"/><xs:enumeration value="none"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="relief" type="nonNegativeDecimal" default="0"/>
    <xs:attribute name="angle" type="xs:double" default="0"/>
    <xs:attribute name="amount" type="xs:double" default="1"/>
    <xs:attribute name="size" type="nonNegativeDecimal" default="1"/>
    <xs:attribute name="frequency" type="xs:double" default="1"/>
    <xs:attribute name="speed" type="xs:double" default="1"/>
    <xs:attribute name="seed" type="xs:unsignedLong"/>
    <xs:attribute name="centerX" type="xs:double"/>
    <xs:attribute name="centerY" type="xs:double"/>
    <xs:attribute name="samples" type="xs:positiveInteger" default="16"/>
    <xs:attribute name="lift" type="xs:string"/>
    <xs:attribute name="gamma" type="xs:string"/>
    <xs:attribute name="gain" type="xs:string"/>
    <xs:attribute name="slope" type="xs:string"/>
    <xs:attribute name="offset" type="xs:string"/>
    <xs:attribute name="power" type="xs:string"/>
    <xs:attribute name="temperature" type="xs:double" default="0"/>
    <xs:attribute name="tint" type="xs:double" default="0"/>
    <xs:attribute name="exposure" type="xs:double" default="0"/>
    <xs:attribute name="hue" type="xs:double" default="0"/>
    <xs:attribute name="channel" default="rgb">
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="rgb"/><xs:enumeration value="red"/><xs:enumeration value="green"/>
        <xs:enumeration value="blue"/><xs:enumeration value="alpha"/><xs:enumeration value="luma"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="curve" type="xs:string"/>
    <xs:attribute name="inputBlack" type="xs:double" default="0"/>
    <xs:attribute name="inputWhite" type="xs:double" default="1"/>
    <xs:attribute name="outputBlack" type="xs:double" default="0"/>
    <xs:attribute name="outputWhite" type="xs:double" default="1"/>
    <xs:attribute name="levels" type="xs:positiveInteger" default="8"/>
    <xs:attribute name="keyColor" type="colorType"/>
    <xs:attribute name="tolerance" type="unitDecimal" default="0.2"/>
    <xs:attribute name="softness" type="unitDecimal" default="0.1"/>
    <xs:attribute name="spill" type="unitDecimal" default="0.5"/>
    <xs:attribute name="source" type="xs:IDREF">
      <xs:annotation><xs:documentation>Second input: displacement map, gradient-map paint source, difference-key plate.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="src" type="xs:anyURI"/>
    <xs:attribute name="space" type="colorSpaceType"/>
    <xs:attribute name="tonemapper" default="aces">
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="aces"/><xs:enumeration value="agx"/><xs:enumeration value="filmic"/>
        <xs:enumeration value="reinhard"/><xs:enumeration value="hable"/><xs:enumeration value="pq-to-sdr"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="position" default="outside">
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="outside"/><xs:enumeration value="inside"/><xs:enumeration value="center"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="compositeOriginal" default="behind">
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="behind"/><xs:enumeration value="on-top"/><xs:enumeration value="none"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
  </xs:complexType>
  <xs:complexType name="effectsType">
    <xs:sequence><xs:element name="effect" type="effectType" maxOccurs="unbounded"/></xs:sequence>
  </xs:complexType>

  <!-- ===================================================== lights -->
  <xs:complexType name="lightType">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:group ref="animationElements"/>
      <xs:element name="transformConstraint" type="transformConstraintType"/>
    </xs:choice>
    <xs:attribute name="id" type="xs:ID" use="required"/>
    <xs:attribute name="type" use="required">
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="ambient"/><xs:enumeration value="directional"/>
        <xs:enumeration value="point"/><xs:enumeration value="spot"/>
        <xs:enumeration value="rect-area"/><xs:enumeration value="disk-area"/>
        <xs:enumeration value="sphere-area"/><xs:enumeration value="dome"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="color" type="colorType" default="#FFFFFFFF"/>
    <xs:attribute name="colorTemperature" type="kelvinType"/>
    <xs:attribute name="intensity" type="lightIntensityType" default="1"/>
    <xs:attribute name="exposure" type="xs:double" default="0"/>
    <xs:attribute name="range" type="positiveDecimal"/>
    <xs:attribute name="falloff" type="positiveDecimal" default="2"/>
    <xs:attribute name="spotAngle" type="spotAngleType" default="45"/>
    <xs:attribute name="innerConeAngle" type="nonNegativeDecimal"/>
    <xs:attribute name="castShadow" type="xs:boolean" default="false"/>
    <xs:attribute name="shadowSoftness" type="nonNegativeDecimal" default="0"/>
    <xs:attribute name="shadowBias" type="xs:double" default="0.0005"/>
    <xs:attribute name="x" type="xs:double" default="0"/>
    <xs:attribute name="y" type="xs:double" default="0"/>
    <xs:attribute name="z" type="xs:double" default="0"/>
    <xs:attribute name="yaw" type="xs:double" default="0"/>
    <xs:attribute name="pitch" type="xs:double" default="0"/>
    <xs:attribute name="roll" type="xs:double" default="0"/>
    <xs:attribute name="width" type="positiveDecimal"/>
    <xs:attribute name="height" type="positiveDecimal"/>
    <xs:attribute name="radius" type="positiveDecimal"/>
    <xs:attribute name="ies" type="xs:anyURI"/>
    <xs:attribute name="environment" type="xs:anyURI">
      <xs:annotation><xs:documentation>type="dome": equirectangular HDRI used for image-based lighting and reflections.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="environmentVisible" type="xs:boolean" default="false"/>
    <xs:attribute name="affectsDiffuse" type="xs:boolean" default="true"/>
    <xs:attribute name="affectsSpecular" type="xs:boolean" default="true"/>
    <xs:attribute name="shadowMapSize" default="2048">
      <xs:simpleType><xs:restriction base="xs:positiveInteger">
        <xs:minInclusive value="16"/><xs:maxInclusive value="8192"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
  </xs:complexType>
  <xs:complexType name="lightsType">
    <xs:sequence><xs:element name="light" type="lightType" maxOccurs="unbounded"/></xs:sequence>
  </xs:complexType>

  <!-- ===================================================== physics -->
  <xs:complexType name="forceFieldType">
    <xs:group ref="animationElements" minOccurs="0" maxOccurs="unbounded"/>
    <xs:attribute name="id" type="xs:ID" use="required"/>
    <xs:attribute name="type" use="required">
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="directional"/><xs:enumeration value="radial"/>
        <xs:enumeration value="vortex"/><xs:enumeration value="turbulence"/>
        <xs:enumeration value="drag"/><xs:enumeration value="wind"/>
        <xs:enumeration value="attractor-path"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="x" type="xs:double" default="0"/>
    <xs:attribute name="y" type="xs:double" default="0"/>
    <xs:attribute name="forceX" type="xs:double" default="0"/>
    <xs:attribute name="forceY" type="xs:double" default="0"/>
    <xs:attribute name="strength" type="xs:double" default="0"/>
    <xs:attribute name="falloff" type="xs:double" default="0"/>
    <xs:attribute name="radius" type="nonNegativeDecimal"/>
    <xs:attribute name="scale" type="positiveDecimal" default="1"/>
    <xs:attribute name="path" type="xs:string"/>
    <xs:attribute name="seed" type="xs:unsignedLong"/>
    <xs:attribute name="start" type="xs:double" default="0"/>
    <xs:attribute name="end" type="xs:double"/>
    <xs:attribute name="affects" default="all">
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="all"/><xs:enumeration value="bodies"/><xs:enumeration value="particles"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
  </xs:complexType>
  <xs:complexType name="constraintType">
    <xs:annotation><xs:documentation>
      spring/distance/rope/hinge/slider/weld/motor join bodies a and b; pin ties
      body a to the world point x, y (b is not allowed) and is rigid unless
      stiffness is given. breakForce removes the constraint when exceeded.
    </xs:documentation></xs:annotation>
    <xs:attribute name="id" type="xs:ID" use="required"/>
    <xs:attribute name="type" use="required">
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="spring"/><xs:enumeration value="distance"/>
        <xs:enumeration value="pin"/><xs:enumeration value="rope"/>
        <xs:enumeration value="hinge"/><xs:enumeration value="slider"/>
        <xs:enumeration value="weld"/><xs:enumeration value="motor"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="a" type="xs:IDREF" use="required"/>
    <xs:attribute name="b" type="xs:IDREF"/>
    <xs:attribute name="x" type="xs:double"/>
    <xs:attribute name="y" type="xs:double"/>
    <xs:attribute name="restLength" type="xs:double"/>
    <xs:attribute name="stiffness" type="xs:double"/>
    <xs:attribute name="damping" type="xs:double"/>
    <xs:attribute name="minAngle" type="xs:double"/>
    <xs:attribute name="maxAngle" type="xs:double"/>
    <xs:attribute name="axisAngle" type="xs:double" default="0"/>
    <xs:attribute name="motorSpeed" type="xs:double" default="0"/>
    <xs:attribute name="maxForce" type="nonNegativeDecimal"/>
    <xs:attribute name="breakForce" type="nonNegativeDecimal"/>
  </xs:complexType>
  <xs:complexType name="physicsType">
    <xs:annotation><xs:documentation>
      softBody: validation also rejects a body whose stable integration needs
      more than 4096 substeps per fixedStep. The physics world is metres, +y up;
      pixelsPerMeter maps it to screen pixels (+y down).
    </xs:documentation></xs:annotation>
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="forceField" type="forceFieldType"/>
      <xs:element name="constraint" type="constraintType"/>
    </xs:choice>
    <xs:attribute name="fixedStep" type="positiveDecimal" default="0.008333333333333333"/>
    <xs:attribute name="gravityX" type="xs:double" default="0"/>
    <xs:attribute name="gravityY" type="xs:double" default="-9.80665"/>
    <xs:attribute name="pixelsPerMeter" type="positiveDecimal" default="100"/>
    <xs:attribute name="solverIterations" type="xs:positiveInteger" default="8"/>
    <xs:attribute name="start" type="xs:double" default="0"/>
    <xs:attribute name="bounds" default="none">
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="none"/><xs:enumeration value="frame"/><xs:enumeration value="floor"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="cache" type="xs:anyURI"/>
    <xs:attribute name="cacheSha256" type="sha256Type"/>
  </xs:complexType>

  <!-- ===================================================== tracking data -->
  <xs:complexType name="trackDataType">
    <xs:attribute name="id" type="xs:ID" use="required"/>
    <xs:attribute name="src" type="xs:anyURI" use="required"/>
    <xs:attribute name="kind" use="required">
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="point"/><xs:enumeration value="planar"/>
        <xs:enumeration value="camera"/><xs:enumeration value="mask"/>
        <xs:enumeration value="face"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="format" default="json">
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="json"/><xs:enumeration value="csv"/><xs:enumeration value="nuke"/>
        <xs:enumeration value="after-effects"/><xs:enumeration value="mocha"/><xs:enumeration value="fbx"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="footage" type="xs:IDREF"/>
    <xs:attribute name="timeOffset" type="xs:double" default="0"/>
    <xs:attribute name="sha256" type="sha256Type"/>
  </xs:complexType>
  <xs:complexType name="trackingType">
    <xs:sequence><xs:element name="trackData" type="trackDataType" maxOccurs="unbounded"/></xs:sequence>
  </xs:complexType>

  <!-- ===================================================== audio -->
  <xs:simpleType name="audioSecondsType">
    <xs:restriction base="xs:double"><xs:maxInclusive value="1e7"/></xs:restriction>
  </xs:simpleType>
  <xs:complexType name="eqBandType">
    <xs:attribute name="kind" default="peak">
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="peak"/><xs:enumeration value="low-shelf"/><xs:enumeration value="high-shelf"/>
        <xs:enumeration value="highpass"/><xs:enumeration value="lowpass"/><xs:enumeration value="notch"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="frequency" type="positiveDecimal" use="required"/>
    <xs:attribute name="gain" type="decibelType" default="0"/>
    <xs:attribute name="q" type="positiveDecimal" default="0.707"/>
  </xs:complexType>
  <xs:complexType name="audioEffectType">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="band" type="eqBandType"/>
      <xs:group ref="animationElements"/>
      <xs:element name="param" type="paramValueType"/>
    </xs:choice>
    <xs:attribute name="type" use="required">
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="eq"/><xs:enumeration value="highpass"/><xs:enumeration value="lowpass"/>
        <xs:enumeration value="compressor"/><xs:enumeration value="limiter"/><xs:enumeration value="gate"/>
        <xs:enumeration value="de-esser"/><xs:enumeration value="reverb"/><xs:enumeration value="delay"/>
        <xs:enumeration value="chorus"/><xs:enumeration value="pitch-shift"/><xs:enumeration value="noise-reduction"/>
        <xs:enumeration value="stereo-width"/><xs:enumeration value="gain"/><xs:enumeration value="distortion"/>
        <xs:enumeration value="telephone"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="enabled" type="xs:boolean" default="true"/>
    <xs:attribute name="mix" type="unitDecimal" default="1"/>
    <xs:attribute name="frequency" type="positiveDecimal"/>
    <xs:attribute name="gain" type="decibelType" default="0"/>
    <xs:attribute name="threshold" type="decibelType" default="-18"/>
    <xs:attribute name="ratio" type="positiveDecimal" default="4"/>
    <xs:attribute name="attack" type="nonNegativeDecimal" default="0.01"/>
    <xs:attribute name="release" type="nonNegativeDecimal" default="0.1"/>
    <xs:attribute name="knee" type="nonNegativeDecimal" default="3"/>
    <xs:attribute name="time" type="nonNegativeDecimal"/>
    <xs:attribute name="feedback" type="unitDecimal" default="0.3"/>
    <xs:attribute name="roomSize" type="unitDecimal" default="0.5"/>
    <xs:attribute name="width" type="nonNegativeDecimal" default="1"/>
    <xs:attribute name="semitones" type="xs:double" default="0"/>
    <xs:attribute name="amount" type="unitDecimal" default="0.5"/>
    <xs:attribute name="sidechain" type="xs:IDREF"/>
  </xs:complexType>
  <xs:attributeGroup name="duckingAttributes">
    <xs:annotation><xs:documentation>
      Automatic ducking: while any track or bus in duckUnder is above
      duckThreshold, this track's gain falls by duckAmount dB with the given
      attack/release. Replaces hand-drawn volume keyframes under voice-over.
    </xs:documentation></xs:annotation>
    <xs:attribute name="duckUnder" type="xs:IDREFS"/>
    <xs:attribute name="duckAmount" type="decibelType" default="-12"/>
    <xs:attribute name="duckThreshold" type="decibelType" default="-40"/>
    <xs:attribute name="duckAttack" type="nonNegativeDecimal" default="0.15"/>
    <xs:attribute name="duckRelease" type="nonNegativeDecimal" default="0.4"/>
  </xs:attributeGroup>
  <xs:complexType name="audioTrackType">
    <xs:annotation><xs:documentation>volume, pan and gain animate with nested animation elements (audio automation).</xs:documentation></xs:annotation>
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:group ref="animationElements"/>
      <xs:element name="audioEffect" type="audioEffectType"/>
    </xs:choice>
    <xs:attribute name="id" type="xs:ID" use="required"/>
    <xs:attribute name="asset" type="xs:IDREF" use="required"/>
    <xs:attribute name="start" type="audioSecondsType" default="0"/>
    <xs:attribute name="startMarker" type="xs:IDREF"/>
    <xs:attribute name="clipIn" type="audioSecondsType" default="0"/>
    <xs:attribute name="clipOut" type="audioSecondsType"/>
    <xs:attribute name="loop" type="xs:nonNegativeInteger" default="0"/>
    <xs:attribute name="volume" type="unitDecimal" default="1"/>
    <xs:attribute name="gain" type="decibelType" default="0"/>
    <xs:attribute name="pan" type="xs:double" default="0"/>
    <xs:attribute name="fadeIn" type="audioSecondsType" default="0"/>
    <xs:attribute name="fadeOut" type="audioSecondsType" default="0"/>
    <xs:attribute name="fadeCurve" default="linear">
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="linear"/><xs:enumeration value="equal-power"/>
        <xs:enumeration value="logarithmic"/><xs:enumeration value="exponential"/>
        <xs:enumeration value="s-curve"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="speed" type="xs:double" default="1"/>
    <xs:attribute name="preservePitch" type="xs:boolean" default="true"/>
    <xs:attribute name="reverse" type="xs:boolean" default="false"/>
    <xs:attribute name="mute" type="xs:boolean" default="false"/>
    <xs:attribute name="role" default="other">
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="dialogue"/><xs:enumeration value="voiceover"/>
        <xs:enumeration value="music"/><xs:enumeration value="effects"/>
        <xs:enumeration value="ambience"/><xs:enumeration value="audio-description"/>
        <xs:enumeration value="other"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="language" type="languageTagType"/>
    <xs:attribute name="bus" type="xs:IDREF"/>
    <xs:attribute name="fitToDuration" type="xs:boolean" default="false">
      <xs:annotation><xs:documentation>Music edit: loop/trim the asset at bar boundaries (asset @bpm) so it ends exactly at the project end.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attributeGroup ref="duckingAttributes"/>
  </xs:complexType>
  <xs:complexType name="busType">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:group ref="animationElements"/>
      <xs:element name="audioEffect" type="audioEffectType"/>
    </xs:choice>
    <xs:attribute name="id" type="xs:ID" use="required"/>
    <xs:attribute name="volume" type="unitDecimal" default="1"/>
    <xs:attribute name="gain" type="decibelType" default="0"/>
    <xs:attribute name="pan" type="xs:double" default="0"/>
    <xs:attribute name="output" type="xs:IDREF"/>
    <xs:attribute name="mute" type="xs:boolean" default="false"/>
    <xs:attributeGroup ref="duckingAttributes"/>
  </xs:complexType>
  <xs:complexType name="masterType">
    <xs:annotation><xs:documentation>
      Master bus. normalize="integrated" measures ITU-R BS.1770 integrated
      loudness of the full mix and applies static gain to reach @loudness LUFS,
      then the true-peak limiter caps at @truePeak dBTP.
    </xs:documentation></xs:annotation>
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:group ref="animationElements"/>
      <xs:element name="audioEffect" type="audioEffectType"/>
    </xs:choice>
    <xs:attribute name="volume" type="unitDecimal" default="1"/>
    <xs:attribute name="normalize" default="none">
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="none"/><xs:enumeration value="integrated"/><xs:enumeration value="dynamic"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="loudness" type="lufsType" default="-14"/>
    <xs:attribute name="truePeak" type="decibelType" default="-1"/>
    <xs:attribute name="limiter" type="xs:boolean" default="false"/>
    <xs:attribute name="dither" type="xs:boolean" default="true"/>
  </xs:complexType>
  <xs:complexType name="audioMixType">
    <xs:choice maxOccurs="unbounded">
      <xs:element name="audioTrack" type="audioTrackType"/>
      <xs:element name="bus" type="busType"/>
      <xs:element name="master" type="masterType"/>
    </xs:choice>
    <xs:attribute name="sampleRate" type="xs:positiveInteger" default="48000"/>
    <xs:attribute name="channels" type="xs:positiveInteger" default="2"/>
    <xs:attribute name="channelLayout" default="auto">
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="auto"/><xs:enumeration value="mono"/><xs:enumeration value="stereo"/>
        <xs:enumeration value="5.1"/><xs:enumeration value="7.1"/><xs:enumeration value="7.1.4"/>
        <xs:enumeration value="ambisonic-1"/><xs:enumeration value="ambisonic-3"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="bitDepth" default="24">
      <xs:simpleType><xs:restriction base="xs:positiveInteger">
        <xs:enumeration value="16"/><xs:enumeration value="24"/><xs:enumeration value="32"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
  </xs:complexType>

  <!-- ===================================================== captions -->
  <xs:complexType name="wordType">
    <xs:attribute name="start" type="xs:double" use="required"/>
    <xs:attribute name="end" type="xs:double" use="required"/>
    <xs:attribute name="text" type="xs:string" use="required"/>
    <xs:attribute name="emphasis" type="xs:boolean" default="false"/>
  </xs:complexType>
  <xs:complexType name="cueType">
    <xs:sequence><xs:element name="word" type="wordType" minOccurs="0" maxOccurs="unbounded"/></xs:sequence>
    <xs:attribute name="start" type="xs:double" use="required"/>
    <xs:attribute name="end" type="xs:double" use="required"/>
    <xs:attribute name="text" type="xs:string"/>
    <xs:attribute name="speaker" type="xs:string"/>
    <xs:attribute name="style" type="xs:IDREF"/>
    <xs:attribute name="position" type="xs:string"/>
  </xs:complexType>
  <xs:complexType name="captionTrackType">
    <xs:annotation><xs:documentation>
      Captions from inline cues, a subtitle file (@src), or a transcription of
      audio track @transcribe. Transcriptions are read from @cache (verified by
      @cacheSha256) so renders stay deterministic. mode=burn draws them into the
      picture using @preset and @style; sidecar writes a file next to each output.
    </xs:documentation></xs:annotation>
    <xs:sequence><xs:element name="cue" type="cueType" minOccurs="0" maxOccurs="unbounded"/></xs:sequence>
    <xs:attribute name="id" type="xs:ID" use="required"/>
    <xs:attribute name="language" type="languageTagType" use="required"/>
    <xs:attribute name="label" type="xs:string"/>
    <xs:attribute name="kind" default="captions">
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="captions"/><xs:enumeration value="subtitles"/>
        <xs:enumeration value="sdh"/><xs:enumeration value="forced"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="src" type="xs:anyURI"/>
    <xs:attribute name="format">
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="srt"/><xs:enumeration value="vtt"/><xs:enumeration value="ass"/>
        <xs:enumeration value="ttml"/><xs:enumeration value="itt"/><xs:enumeration value="scc"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="transcribe" type="xs:IDREF"/>
    <xs:attribute name="cache" type="xs:anyURI"/>
    <xs:attribute name="cacheSha256" type="sha256Type"/>
    <xs:attribute name="mode" default="burn">
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="burn"/><xs:enumeration value="sidecar"/><xs:enumeration value="both"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="preset" default="classic">
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="classic"/><xs:enumeration value="boxed-line"/>
        <xs:enumeration value="boxed-word"/><xs:enumeration value="one-word"/>
        <xs:enumeration value="karaoke"/><xs:enumeration value="highlight"/>
        <xs:enumeration value="pop"/><xs:enumeration value="fade"/>
        <xs:enumeration value="bounce"/><xs:enumeration value="slide"/>
        <xs:enumeration value="typewriter"/><xs:enumeration value="enlarge"/>
        <xs:enumeration value="none"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="style" type="xs:IDREF"/>
    <xs:attribute name="activeStyle" type="xs:IDREF"/>
    <xs:attribute name="activeColor" type="paintType"/>
    <xs:attribute name="maxWordsPerLine" type="xs:positiveInteger"/>
    <xs:attribute name="maxCharsPerLine" type="xs:positiveInteger" default="32"/>
    <xs:attribute name="maxLines" type="xs:positiveInteger" default="2"/>
    <xs:attribute name="x" type="lengthType" default="50%"/>
    <xs:attribute name="y" type="lengthType" default="75%"/>
    <xs:attribute name="width" type="positiveLengthType" default="85%"/>
    <xs:attribute name="safeArea" type="xs:IDREF"/>
    <xs:attribute name="z" type="xs:int" default="1000000"/>
    <xs:attribute name="profanityFilter" type="xs:boolean" default="false"/>
  </xs:complexType>
  <xs:complexType name="captionsType">
    <xs:sequence><xs:element name="captionTrack" type="captionTrackType" maxOccurs="unbounded"/></xs:sequence>
  </xs:complexType>

  <!-- ===================================================== markers -->
  <xs:complexType name="markerType">
    <xs:attribute name="id" type="xs:ID"/>
    <xs:attribute name="time" type="xs:double" use="required"/>
    <xs:attribute name="duration" type="nonNegativeDecimal" default="0"/>
    <xs:attribute name="kind" default="cue">
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="cue"/><xs:enumeration value="chapter"/><xs:enumeration value="section"/>
        <xs:enumeration value="beat"/><xs:enumeration value="comment"/><xs:enumeration value="todo"/>
        <xs:enumeration value="cta"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="label" type="xs:string"/>
    <xs:attribute name="color" type="colorType"/>
  </xs:complexType>
  <xs:complexType name="beatGridType">
    <xs:annotation><xs:documentation>Musical grid for cutting on the beat; expressions read beat() and keys can snap with @marker to generated ids beat.N and bar.N.</xs:documentation></xs:annotation>
    <xs:attribute name="bpm" type="positiveDecimal" use="required"/>
    <xs:attribute name="offset" type="xs:double" default="0"/>
    <xs:attribute name="beatsPerBar" type="xs:positiveInteger" default="4"/>
    <xs:attribute name="source" type="xs:IDREF"/>
  </xs:complexType>
  <xs:complexType name="markersType">
    <xs:choice maxOccurs="unbounded">
      <xs:element name="marker" type="markerType"/>
      <xs:element name="beatGrid" type="beatGridType"/>
    </xs:choice>
  </xs:complexType>

  <!-- ===================================================== parameters and variants -->
  <xs:complexType name="paramType">
    <xs:annotation><xs:documentation>
      Template input. Values reach the document through {{id}} in text,
      param('id') in expressions and conditions, bind elements, and
      link source="param:id". Values come from @default, a variant, a data row
      or the command line (--param id=value).
    </xs:documentation></xs:annotation>
    <xs:attribute name="id" type="xs:ID" use="required"/>
    <xs:attribute name="type" use="required">
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="string"/><xs:enumeration value="number"/><xs:enumeration value="boolean"/>
        <xs:enumeration value="color"/><xs:enumeration value="asset"/><xs:enumeration value="enum"/>
        <xs:enumeration value="list"/><xs:enumeration value="time"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="default" type="xs:string"/>
    <xs:attribute name="label" type="xs:string"/>
    <xs:attribute name="description" type="xs:string"/>
    <xs:attribute name="required" type="xs:boolean" default="false"/>
    <xs:attribute name="min" type="xs:double"/>
    <xs:attribute name="max" type="xs:double"/>
    <xs:attribute name="maxLength" type="xs:positiveInteger"/>
    <xs:attribute name="pattern" type="xs:string"/>
    <xs:attribute name="options" type="xs:string"/>
  </xs:complexType>
  <xs:complexType name="bindType">
    <xs:attribute name="param" type="xs:IDREF" use="required"/>
    <xs:attribute name="target" type="xs:IDREF" use="required"/>
    <xs:attribute name="property" type="xs:NMTOKEN" use="required"/>
    <xs:attribute name="map" type="xs:string">
      <xs:annotation><xs:documentation>Optional value map "in1=out1;in2=out2" applied before assignment.</xs:documentation></xs:annotation>
    </xs:attribute>
  </xs:complexType>
  <xs:complexType name="dataSourceType">
    <xs:annotation><xs:documentation>Rows for repeat/@over and for batch rendering (one output set per row).</xs:documentation></xs:annotation>
    <xs:simpleContent>
      <xs:extension base="xs:string">
        <xs:attribute name="id" type="xs:ID" use="required"/>
        <xs:attribute name="src" type="xs:anyURI"/>
        <xs:attribute name="format" default="json">
          <xs:simpleType><xs:restriction base="xs:string">
            <xs:enumeration value="json"/><xs:enumeration value="csv"/><xs:enumeration value="tsv"/>
          </xs:restriction></xs:simpleType>
        </xs:attribute>
        <xs:attribute name="sha256" type="sha256Type"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>
  <xs:complexType name="setType">
    <xs:attribute name="param" type="xs:IDREF" use="required"/>
    <xs:attribute name="value" type="xs:string" use="required"/>
  </xs:complexType>
  <xs:complexType name="variantType">
    <xs:annotation><xs:documentation>A named parameter set (A/B test cell, language, market).</xs:documentation></xs:annotation>
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="set" type="setType"/>
      <xs:element name="override" type="overrideType"/>
    </xs:choice>
    <xs:attribute name="id" type="xs:ID" use="required"/>
    <xs:attribute name="label" type="xs:string"/>
  </xs:complexType>
  <xs:complexType name="parametersType">
    <xs:choice maxOccurs="unbounded">
      <xs:element name="param" type="paramType"/>
      <xs:element name="bind" type="bindType"/>
      <xs:element name="data" type="dataSourceType"/>
      <xs:element name="variant" type="variantType"/>
    </xs:choice>
  </xs:complexType>

  <!-- ===================================================== layouts and safe areas -->
  <xs:complexType name="safeAreaType">
    <xs:annotation><xs:documentation>
      Regions the platform UI covers. Presets carry the renderer's maintained
      insets for that placement; explicit top/right/bottom/left (fractions of
      the frame) override them. enforce=warn|error checks that text, captions
      and nodes tagged "cta" or "logo" stay inside the safe region.
    </xs:documentation></xs:annotation>
    <xs:attribute name="id" type="xs:ID" use="required"/>
    <xs:attribute name="preset" default="custom">
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="custom"/><xs:enumeration value="title-safe"/><xs:enumeration value="action-safe"/>
        <xs:enumeration value="instagram-reels"/><xs:enumeration value="instagram-stories"/>
        <xs:enumeration value="instagram-feed"/><xs:enumeration value="facebook-reels"/>
        <xs:enumeration value="tiktok"/><xs:enumeration value="youtube-shorts"/>
        <xs:enumeration value="snapchat"/><xs:enumeration value="pinterest-idea"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="top" type="unitDecimal"/>
    <xs:attribute name="right" type="unitDecimal"/>
    <xs:attribute name="bottom" type="unitDecimal"/>
    <xs:attribute name="left" type="unitDecimal"/>
    <xs:attribute name="enforce" default="warn">
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="off"/><xs:enumeration value="warn"/><xs:enumeration value="error"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
  </xs:complexType>
  <xs:complexType name="safeAreasType">
    <xs:sequence><xs:element name="safeArea" type="safeAreaType" maxOccurs="unbounded"/></xs:sequence>
  </xs:complexType>
  <xs:complexType name="layoutType">
    <xs:annotation><xs:documentation>
      An alternative frame (e.g. 9:16, 4:5, 1:1, 16:9). Relative lengths and
      align* attributes reflow automatically; override children handle the rest.
      An output selects it with @layout.
    </xs:documentation></xs:annotation>
    <xs:sequence><xs:element name="override" type="overrideType" minOccurs="0" maxOccurs="unbounded"/></xs:sequence>
    <xs:attribute name="id" type="xs:ID" use="required"/>
    <xs:attribute name="width" type="xs:positiveInteger" use="required"/>
    <xs:attribute name="height" type="xs:positiveInteger" use="required"/>
    <xs:attribute name="aspect" type="aspectType"/>
    <xs:attribute name="safeArea" type="xs:IDREF"/>
    <xs:attribute name="reframe" default="reflow">
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="reflow"/><xs:enumeration value="crop"/><xs:enumeration value="fit"/>
        <xs:enumeration value="fit-blur"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="focusX" type="unitDecimal" default="0.5"/>
    <xs:attribute name="focusY" type="unitDecimal" default="0.5"/>
  </xs:complexType>
  <xs:complexType name="layoutsType">
    <xs:sequence><xs:element name="layout" type="layoutType" maxOccurs="unbounded"/></xs:sequence>
  </xs:complexType>

  <!-- ===================================================== colour management -->
  <xs:complexType name="lookType">
    <xs:attribute name="id" type="xs:ID" use="required"/>
    <xs:attribute name="src" type="xs:anyURI"/>
    <xs:attribute name="space" type="colorSpaceType" default="acescct"/>
    <xs:attribute name="slope" type="xs:string"/>
    <xs:attribute name="offset" type="xs:string"/>
    <xs:attribute name="power" type="xs:string"/>
    <xs:attribute name="saturation" type="xs:double" default="1"/>
    <xs:attribute name="mix" type="unitDecimal" default="1"/>
  </xs:complexType>
  <xs:complexType name="colorManagementType">
    <xs:annotation><xs:documentation>
      Scene-referred pipeline: inputs decode by asset colorSpace+transfer into
      @workingSpace, @looks (LUTs or ASC CDL) apply in order, then the
      display/view transform and tone mapping produce each output's colorSpace
      and transfer. @ocioConfig delegates all of this to an OpenColorIO v2
      config, where @workingSpace, @display, @view and look ids name OCIO objects.
    </xs:documentation></xs:annotation>
    <xs:sequence><xs:element name="look" type="lookType" minOccurs="0" maxOccurs="unbounded"/></xs:sequence>
    <xs:attribute name="ocioConfig" type="xs:anyURI"/>
    <xs:attribute name="workingSpace" type="colorSpaceType" default="linear-srgb"/>
    <xs:attribute name="looks" type="xs:IDREFS"/>
    <xs:attribute name="display" type="xs:string" default="srgb"/>
    <xs:attribute name="view" type="xs:string" default="standard"/>
    <xs:attribute name="toneMapping" default="none">
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="none"/><xs:enumeration value="aces"/><xs:enumeration value="aces2"/>
        <xs:enumeration value="agx"/><xs:enumeration value="filmic"/><xs:enumeration value="reinhard"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="exposure" type="xs:double" default="0"/>
    <xs:attribute name="bitDepth" default="16f">
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="8"/><xs:enumeration value="16"/><xs:enumeration value="16f"/><xs:enumeration value="32f"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
  </xs:complexType>

  <!-- ===================================================== metadata and accessibility -->
  <xs:complexType name="metaType">
    <xs:attribute name="name" type="xs:string" use="required"/>
    <xs:attribute name="value" type="xs:string" use="required"/>
  </xs:complexType>
  <xs:complexType name="accessibilityType">
    <xs:annotation><xs:documentation>
      flashCheck runs a photosensitive-seizure analysis (general and red flashes
      above 3 per second over the ITU-R BT.1702 / WCAG 2.3.1 area threshold).
      contrastCheck verifies burned-in text and captions against their
      background at @minContrast.
    </xs:documentation></xs:annotation>
    <xs:attribute name="description" type="xs:string"/>
    <xs:attribute name="audioDescription" type="xs:IDREF"/>
    <xs:attribute name="requireCaptions" type="xs:boolean" default="false"/>
    <xs:attribute name="flashCheck" default="warn">
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="off"/><xs:enumeration value="warn"/><xs:enumeration value="error"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="contrastCheck" default="off">
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="off"/><xs:enumeration value="warn"/><xs:enumeration value="error"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="minContrast" type="positiveDecimal" default="4.5"/>
  </xs:complexType>
  <xs:complexType name="metadataType">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="meta" type="metaType"/>
      <xs:element name="accessibility" type="accessibilityType"/>
    </xs:choice>
    <xs:attribute name="title" type="xs:string"/>
    <xs:attribute name="author" type="xs:string"/>
    <xs:attribute name="description" type="xs:string"/>
    <xs:attribute name="keywords" type="xs:string"/>
    <xs:attribute name="copyright" type="xs:string"/>
    <xs:attribute name="revision" type="xs:string"/>
    <xs:attribute name="created" type="xs:dateTime"/>
    <xs:attribute name="modified" type="xs:dateTime"/>
    <xs:attribute name="generator" type="xs:string"/>
    <xs:attribute name="language" type="languageTagType"/>
  </xs:complexType>

  <!-- ===================================================== 360 -->
  <xs:complexType name="scene360Type">
    <xs:attribute name="layout" default="equirectangular">
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="equirectangular"/><xs:enumeration value="cubemap"/>
        <xs:enumeration value="eac"/><xs:enumeration value="fisheye-180"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="width" type="xs:positiveInteger" default="3840"/>
    <xs:attribute name="height" type="xs:positiveInteger" default="1920"/>
    <xs:attribute name="viewportCamera" type="xs:IDREF"/>
    <xs:attribute name="stereo" default="mono">
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="mono"/><xs:enumeration value="top-bottom"/><xs:enumeration value="left-right"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="interpupillary" type="positiveDecimal" default="0.064"/>
  </xs:complexType>

  <!-- ===================================================== project -->
  <xs:complexType name="projectType">
    <xs:attribute name="width" type="xs:positiveInteger" use="required"/>
    <xs:attribute name="height" type="xs:positiveInteger" use="required"/>
    <xs:attribute name="fps" type="fpsType" use="required"/>
    <xs:attribute name="duration" type="durationType" use="required"/>
    <xs:attribute name="seed" type="xs:unsignedLong" default="0"/>
    <xs:attribute name="linearLight" type="xs:boolean" default="true"/>
    <xs:attribute name="workingColorSpace" type="colorSpaceType" default="srgb"/>
    <xs:attribute name="background" type="paintType" default="#000000FF"/>
    <xs:attribute name="mode" default="standard">
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="standard"/><xs:enumeration value="equirectangular"/>
        <xs:enumeration value="viewport"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="antialias3d" default="1">
      <xs:simpleType><xs:restriction base="xs:positiveInteger"><xs:maxInclusive value="4"/></xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="motionBlur" type="xs:boolean" default="false"/>
    <xs:attribute name="shutterAngle" default="180">
      <xs:simpleType><xs:restriction base="xs:double">
        <xs:minInclusive value="0"/><xs:maxInclusive value="720"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="shutterPhase" type="xs:double" default="-90"/>
    <xs:attribute name="motionBlurSamples" default="16">
      <xs:simpleType><xs:restriction base="xs:positiveInteger"><xs:maxInclusive value="256"/></xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="adaptiveMotionBlur" type="xs:boolean" default="true"/>
    <xs:attribute name="timecodeStart" type="timecodeType"/>
    <xs:attribute name="pixelAspect" type="positiveDecimal" default="1"/>
    <xs:attribute name="safeArea" type="xs:IDREF"/>
    <xs:attribute name="quality" default="final">
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="draft"/><xs:enumeration value="preview"/><xs:enumeration value="final"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
  </xs:complexType>

  <!-- ===================================================== outputs -->
  <xs:complexType name="stillType">
    <xs:attribute name="time" type="xs:double" default="0"/>
    <xs:attribute name="marker" type="xs:IDREF"/>
    <xs:attribute name="path" type="xs:anyURI" use="required"/>
    <xs:attribute name="format" default="jpeg">
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="jpeg"/><xs:enumeration value="png"/><xs:enumeration value="webp"/>
        <xs:enumeration value="avif"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="width" type="xs:positiveInteger"/>
    <xs:attribute name="quality" type="unitDecimal" default="0.9"/>
  </xs:complexType>
  <xs:complexType name="destinationType">
    <xs:annotation><xs:documentation>Post-render delivery. Credentials are never stored in the document: @credentials names an environment profile.</xs:documentation></xs:annotation>
    <xs:attribute name="kind" use="required">
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="file"/><xs:enumeration value="s3"/><xs:enumeration value="gcs"/>
        <xs:enumeration value="azure-blob"/><xs:enumeration value="http-put"/><xs:enumeration value="sftp"/>
        <xs:enumeration value="webhook"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="uri" type="xs:anyURI" use="required"/>
    <xs:attribute name="credentials" type="xs:NMTOKEN"/>
  </xs:complexType>
  <xs:complexType name="outputType">
    <xs:annotation><xs:documentation>
      Several outputs render one scene into different placements. layout picks a
      layoutVariant frame; variant picks a parameter set; start/end render a
      range. Width/height default to the layout's, else the project's.
      Sequence codecs write numbered files at @path (printf pattern).
    </xs:documentation></xs:annotation>
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="poster" type="stillType"/>
      <xs:element name="thumbnail" type="stillType"/>
      <xs:element name="destination" type="destinationType"/>
    </xs:choice>
    <xs:attribute name="id" type="xs:ID"/>
    <xs:attribute name="path" type="xs:anyURI" use="required"/>
    <xs:attribute name="codec" use="required">
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="h264"/><xs:enumeration value="h265"/><xs:enumeration value="ffv1"/>
        <xs:enumeration value="av1"/><xs:enumeration value="vp9"/><xs:enumeration value="prores"/>
        <xs:enumeration value="dnxhr"/><xs:enumeration value="gif"/><xs:enumeration value="apng"/>
        <xs:enumeration value="webp"/><xs:enumeration value="png-sequence"/>
        <xs:enumeration value="jpeg-sequence"/><xs:enumeration value="exr-sequence"/>
        <xs:enumeration value="tiff-sequence"/><xs:enumeration value="audio-only"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="container">
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="mp4"/><xs:enumeration value="mov"/><xs:enumeration value="mkv"/>
        <xs:enumeration value="webm"/><xs:enumeration value="mxf"/><xs:enumeration value="wav"/>
        <xs:enumeration value="m4a"/><xs:enumeration value="mp3"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="width" type="xs:positiveInteger"/>
    <xs:attribute name="height" type="xs:positiveInteger"/>
    <xs:attribute name="fps" type="fpsType"/>
    <xs:attribute name="layout" type="xs:IDREF"/>
    <xs:attribute name="variant" type="xs:IDREF"/>
    <xs:attribute name="start" type="xs:double" default="0"/>
    <xs:attribute name="end" type="xs:double"/>
    <xs:attribute name="pixelFormat" type="xs:string" default="yuv420p"/>
    <xs:attribute name="preset" type="xs:string" default="medium"/>
    <xs:attribute name="profile" type="xs:string"/>
    <xs:attribute name="level" type="xs:string"/>
    <xs:attribute name="proresProfile">
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="proxy"/><xs:enumeration value="lt"/><xs:enumeration value="422"/>
        <xs:enumeration value="hq"/><xs:enumeration value="4444"/><xs:enumeration value="4444xq"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="crf" type="xs:nonNegativeInteger" default="18"/>
    <xs:attribute name="bitrate" type="xs:positiveInteger"/>
    <xs:attribute name="maxBitrate" type="xs:positiveInteger"/>
    <xs:attribute name="bufferSize" type="xs:positiveInteger"/>
    <xs:attribute name="twoPass" type="xs:boolean" default="false"/>
    <xs:attribute name="keyframeInterval" type="positiveDecimal" default="2"/>
    <xs:attribute name="bFrames" type="xs:nonNegativeInteger"/>
    <xs:attribute name="faststart" type="xs:boolean" default="true"/>
    <xs:attribute name="alpha" type="xs:boolean" default="false"/>
    <xs:attribute name="audioCodec" type="xs:string" default="aac"/>
    <xs:attribute name="audioBitrate" type="xs:positiveInteger" default="192000"/>
    <xs:attribute name="audio" type="xs:boolean" default="true"/>
    <xs:attribute name="colorSpace" type="colorSpaceType" default="srgb"/>
    <xs:attribute name="transfer" type="transferType" default="auto"/>
    <xs:attribute name="colorRange" default="limited">
      <xs:simpleType><xs:restriction base="xs:string">
        <xs:enumeration value="limited"/><xs:enumeration value="full"/>
      </xs:restriction></xs:simpleType>
    </xs:attribute>
    <xs:attribute name="maxCLL" type="xs:nonNegativeInteger"/>
    <xs:attribute name="maxFALL" type="xs:nonNegativeInteger"/>
    <xs:attribute name="masteringDisplay" type="xs:string"/>
    <xs:attribute name="sphericalMetadata" type="xs:boolean" default="true"/>
    <xs:attribute name="captions" type="xs:IDREFS"/>
    <xs:attribute name="burnCaptions" type="xs:IDREF"/>
    <xs:attribute name="loopCount" type="xs:nonNegativeInteger" default="0">
      <xs:annotation><xs:documentation>GIF/APNG/WebP loop count; 0 = infinite.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="maxFileSize" type="xs:positiveInteger">
      <xs:annotation><xs:documentation>Bytes; the encoder picks a bitrate that fits (platform upload limits).</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="embedMetadata" type="xs:boolean" default="true"/>
    <xs:attribute name="representation" type="xs:NMTOKEN">
      <xs:annotation><xs:documentation>Preferred asset representation name for this output (e.g. "proxy" for drafts).</xs:documentation></xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <!-- ===================================================== root -->
  <xs:element name="scene">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="project" type="projectType"/>
        <xs:element name="metadata" type="metadataType" minOccurs="0"/>
        <xs:element name="parameters" type="parametersType" minOccurs="0"/>
        <xs:element name="styles" type="stylesType" minOccurs="0"/>
        <xs:element name="colorManagement" type="colorManagementType" minOccurs="0"/>
        <xs:element name="output" type="outputType" minOccurs="0" maxOccurs="unbounded"/>
        <xs:element name="layouts" type="layoutsType" minOccurs="0"/>
        <xs:element name="safeAreas" type="safeAreasType" minOccurs="0"/>
        <xs:element name="assets" type="assetsType" minOccurs="0"/>
        <xs:element name="paints" type="paintsType" minOccurs="0"/>
        <xs:element name="materials" type="materialsType" minOccurs="0"/>
        <xs:element name="symbols" type="symbolsType" minOccurs="0"/>
        <xs:element name="scene360" type="scene360Type" minOccurs="0"/>
        <xs:element name="markers" type="markersType" minOccurs="0"/>
        <xs:element name="tracking" type="trackingType" minOccurs="0"/>
        <xs:element name="composition" type="compositionType"/>
        <xs:element name="lights" type="lightsType" minOccurs="0"/>
        <xs:element name="effects" type="effectsType" minOccurs="0"/>
        <xs:element name="physics" type="physicsType" minOccurs="0"/>
        <xs:element name="audioMix" type="audioMixType" minOccurs="0"/>
        <xs:element name="captions" type="captionsType" minOccurs="0"/>
      </xs:sequence>
      <xs:attribute name="version" use="required">
        <xs:simpleType><xs:restriction base="xs:string">
          <xs:enumeration value="1.0"/><xs:enumeration value="1.1"/>
        </xs:restriction></xs:simpleType>
      </xs:attribute>
    </xs:complexType>
  </xs:element>
</xs:schema>
