{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "scene-render-capabilities-1",
  "title": "scene-render engine capability manifest, format 1 (SREP 22, with entry conditions of SREP 63)",
  "type": "object",
  "required": ["format", "engine", "schema", "entries"],
  "additionalProperties": false,
  "properties": {
    "format": {"const": "scene-render-capabilities/1"},
    "engine": {
      "type": "object",
      "required": ["name", "version"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "schema": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["construct", "status"],
        "additionalProperties": false,
        "properties": {
          "construct": {"$ref": "#/$defs/construct"},
          "status": {"enum": ["exact", "approximate", "reported", "unsupported"]},
          "definition": {"type": "string"},
          "note": {"type": "string"},
          "when": {
            "description": "SREP 63: the entry applies to a document that uses its construct and every construct listed here",
            "type": "array",
            "minItems": 1,
            "items": {"$ref": "#/$defs/construct"}
          }
        }
      }
    }
  },
  "$defs": {
    "construct": {
      "description": "an element name, element/@attribute, or element/@attribute=value (SREP 22)",
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*(/@[A-Za-z_][A-Za-z0-9_.-]*(=[^=\\s]+)?)?$"
    }
  }
}
