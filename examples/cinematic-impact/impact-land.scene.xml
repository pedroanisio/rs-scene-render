<?xml version="1.0" encoding="UTF-8"?>
<!-- Impact on land, in metres and seconds (physics/@pixelsPerMeter is 1: a scene unit is a metre).
     A 2 m radius rock of 2700 kg/m3 (90 478 kg) arrives at 100 m/s, 60 degrees above the ground, on
     soft rock. Nothing here says when anything happens: the crater, the smoke and the ejecta
     are caused by the rock's own contact, so a different speed, mass or
     angle gives a different result with no other edit. The numbers are the engine's, not a
     prediction of a measured event. -->
<scene version="1.3">
  <project width="1280" height="720" fps="24" duration="6" background="#8FA9C4"/>
  <metadata><meta name="simulation-kind" value="Impact on land in physical units; effects are consequences of the contact"/></metadata>
  <materials>
    <material id="soil" baseColor="#756653" roughness="0.9"/>
    <material id="rock" baseColor="#392D26" roughness="0.8"/>
  </materials>
  <composition>
    <camera id="camera" x="10" y="-16" z="-120" pitch="-3" fov="42" renderer="pathtrace" pathSamples="8" maxBounces="4" denoise="true"/>
    <!-- launched 118 m above the ground and 74 m back so that it arrives at the origin 1.49 s in, at 100 m/s and
         60 degrees: 50 m/s along the ground and 86.6 m/s down -->
    <object3D id="impactor" primitive="sphere" radius="2" segments="24" x="-74.4" y="-120" material="rock">
      <rigidBody shape="sphere" mass="90478" velocityX="50" velocityY="72" restitution="0" linearDamping="0" angularDamping="0"/>
    </object3D>
    <object3D id="ground" primitive="plane" width="160" height="160" segments="160" y="0" rotationX="-90" material="soil">
      <crater id="pit" source="impactor" targetMaterial="softRock" capture="true"/>
      <rigidBody type="static" shape="auto"/>
    </object3D>
    <!-- 4000 particles stand for the 80 % of the crater's mass that is thrown out: each is born when and where
         the impact launches it, with its own velocity and a mass of about 40 kg (a rock of 0.34 m at 2100 kg/m3),
         and then falls under gravity. They have no collider: with the ground as one, the particle solver stops
         ("more than 16 collisions in one particle step") while the crater is still growing under them, so they
         fall through the ground, which hides them. Only the render size is authored here. -->
    <particles3D id="ejecta" shape="sphere" segments="6" material="rock" rate="0" seed="20261004" size="0.34" gravityY="9.80665" drag="0" lifetime="6" dt="0.0416666666666667" maxParticles="4000">
      <burst crater="pit" count="4000"/>
    </particles3D>
    <!-- 48 x 56 x 48 m at 1 m cells, the ground 18 m above the bottom face: the smoke source is a sphere of
         the crater's radius (about 5.5 m) on the ground, and the open faces are all at least 12 cells from
         it, because a face closer than that changes the flow of the cloud (measured on the hero scene) -->
    <object3D id="cloud" primitive="volume" y="-10">
      <pyro width="48" height="56" depth="48" voxelSize="1" boundary="open" dt="0.0416666666666667" ambientTemperature="300" buoyancy="0.0327" cooling="0.1" dissipation="0.02" vorticity="0.5" turbulence="0.5" seed="20261004" pressureIterations="100" pressureTolerance="0.001">
        <pyroSource crater="pit"/>
      </pyro>
      <!-- extinction per unit volume fraction of dust: 3 Q / (2 d) for 100 micrometre grains, Q = 2 -->
      <medium extinction="30000" albedo="#B8B4AE" blackbody="true" emissionScale="1" stepSize="1" maxSteps="256"/>
    </object3D>
  </composition>
  <lights>
    <light id="sky" type="dome" environment="sky.hdr" environmentVisible="true" intensity="1"/>
    <light id="sun" type="directional" color="#FFE7C9" yaw="-35" pitch="-50" intensity="3" castShadow="true"/>
  </lights>
  <!-- the contacts of the ground's triangle edges are fixed, so a body that slides over it is not pushed sideways -->
  <physics fixInternalEdges="true" gravityY="-9.80665" pixelsPerMeter="1" fixedStep="0.008333333333333333" bounds="none"/>
</scene>
