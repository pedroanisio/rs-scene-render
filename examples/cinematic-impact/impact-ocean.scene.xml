<?xml version="1.0" encoding="UTF-8"?>
<!-- Impact in the ocean, in metres and seconds (physics/@pixelsPerMeter is 1: a scene unit is a metre).
     The rock of impact-land.scene.xml (2 m radius, 90 478 kg) arrives at the water at 100 m/s, 60
     degrees above it, falls through 20 m of water that carries it as a floating body would be carried
     (bodyCoupling="full": buoyancy, a vertical form drag, and the horizontal momentum it gives the water
     back) and hits the seabed, where it makes a crater. The wave is made by the rock moving through the water and by the bed that
     the crater lowers, as the second-order ocean sees them: there is no waterImpulse. There is no smoke
     here: the crater is under water and the engine has no smoke inside water, so a smoke source from this
     crater would make a cloud at the bottom of the sea. The numbers are the engine's, not a prediction. -->
<scene version="1.3">
  <project width="1280" height="720" fps="24" duration="6" background="#8FA9C4"/>
  <metadata><meta name="simulation-kind" value="Impact in the ocean in physical units; effects are consequences of the contact"/></metadata>
  <materials>
    <material id="bed" baseColor="#756653" roughness="0.9"/>
    <material id="water" baseColor="#06212C" roughness="0.06" ior="1.333" doubleSided="true"/>
    <material id="rock" baseColor="#392D26" roughness="0.8"/>
  </materials>
  <composition>
    <camera id="camera" x="10" y="-16" z="-120" pitch="-3" fov="42" renderer="pathtrace" pathSamples="8" maxBounces="4" denoise="true"/>
    <!-- launched 118 m above the water and 74 m back so that it reaches the water 1.49 s in, at 100 m/s and
         60 degrees: 50 m/s along the surface and 86.6 m/s down -->
    <object3D id="impactor" primitive="sphere" radius="2" segments="24" x="-74.4" y="-120" material="rock">
      <rigidBody shape="sphere" mass="90478" velocityX="50" velocityY="72" restitution="0" linearDamping="0" angularDamping="0"/>
    </object3D>
    <object3D id="seabed" primitive="plane" width="160" height="160" segments="160" y="20" rotationX="-90" material="bed">
      <crater id="pit" source="impactor" targetMaterial="softRock"/>
      <rigidBody type="static" shape="auto"/>
    </object3D>
    <object3D id="farSea" primitive="plane" width="40000" height="40000" y="0.4" rotationX="-90" material="water"/>
    <!-- 192 x 192 m at 1.5 m cells over 20 m of water; the waves cross 60 m in the 6 s and stay inside -->
    <ocean id="sea" width="192" depth="192" cellSize="1.5" bottomDepth="20" order="2" material="water" dt="0.0416666666666667" boundary="closed" colliders="seabed impactor" bodyCoupling="full" maxWork="2000000000"/>
  </composition>
  <lights>
    <light id="sky" type="dome" environment="sky.hdr" environmentVisible="true" intensity="1"/>
    <light id="sun" type="directional" color="#FFE7C9" yaw="-35" pitch="-50" intensity="3" castShadow="true"/>
  </lights>
  <physics gravityY="-9.80665" pixelsPerMeter="1" fixedStep="0.008333333333333333" bounds="none"/>
</scene>
